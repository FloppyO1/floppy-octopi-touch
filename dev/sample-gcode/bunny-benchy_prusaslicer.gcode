;TYPE:Custom
;INIZIO START GCODE MIO;
;per scaldare bed e h_end insieme
M140 S80
M104 S230 T0
M109 S230 T0
M190 S80

G21 ;metric values
G90 ;absolute positioning
M82 ;set extruder to absolute mode
M107 ;start with the fan off
G28 X0 Y0 ;move X/Y to min endstops
G28 Z0 ;move Z to min endstops
G1 Z15.0 F9000 ;move the platform down 15mm

;movimento per spurgo
G0 X75 F5000
G1 Z0.0 F9000 ;move the platform at 0 position

;spurgamento filo (per tornare indietro mettere spurgo prima del movimento in centro)
G92 E0 ;zero the extruded length
G1 E25 F150
G92 E0 ;zero the extruded length

;movimento in centro
G0 X110 F5000
G1 Z0.0 F9000 ;move the platform at 0 position

