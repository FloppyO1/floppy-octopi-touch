# Copy to dev/.env and adjust. Everything has a default, so the file is optional.

OCTOPRINT_VERSION=1.11.8

# Host ports (bound to 127.0.0.1 only)
OCTOPRINT_PORT=5000
AGENT_PORT=8765
FRONTEND_PORT=5173

# Admin account created in the development OctoPrint on first start
OCTOPRINT_DEV_USER=admin
OCTOPRINT_DEV_PASSWORD=admin

# API key used by the agent. octoprint-init registers it as an application key of the dev user
# at every start, so any random string works. A key generated in the OctoPrint UI
# (Settings > Application Keys) can be pasted here as well.
OCTOPRINT_API_KEY=floppyoctotouch-dev-api-key-not-secret
