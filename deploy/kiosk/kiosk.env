# FloppyOctoTouch kiosk options, read by floppyoctotouch-kiosk.service (kept by update.sh).
# Apply a change with: sudo systemctl restart floppyoctotouch-kiosk
#
# Page shown full screen (?kiosk=1 hides the cursor and blocks zoom, selection and the context menu):
#FOT_KIOSK_URL=http://127.0.0.1:8765/?kiosk=1
#
# Screen mode set by the kiosk at start and when the screen wakes up (the 7" screen does not advertise its
# 1024x600 mode, so the default forces it); "preferred" keeps the mode the screen asks for:
#FOT_DISPLAY_MODE=1024x600@60Hz
#
# Extra Chromium flags, separated by spaces (e.g. GPU options):
#FOT_CHROMIUM_FLAGS=
