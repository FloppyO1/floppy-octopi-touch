# FloppyOctoTouch kiosk: cage (Wayland kiosk compositor) running Chromium full screen on tty1.
# Rendered by install.sh (@...@ placeholders). The PAM session (pam_systemd) gives cage the seat and
# XDG_RUNTIME_DIR; getty@tty1 is disabled by the installer and re-enabled by uninstall.sh.
# Chromium options: /etc/floppyoctotouch/kiosk.env.
[Unit]
Description=FloppyOctoTouch kiosk (cage + Chromium on tty1)
After=systemd-user-sessions.service floppyoctotouch-agent.service getty@tty1.service
After=dbus.socket systemd-logind.service
Wants=floppyoctotouch-agent.service dbus.socket systemd-logind.service
Conflicts=getty@tty1.service
ConditionPathExists=/dev/tty1

[Service]
Type=simple
User=@USER@
PAMName=floppyoctotouch-kiosk
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=XDG_SESSION_TYPE=wayland
# Start even when the touch screen's USB cable is not plugged in yet.
Environment=WLR_LIBINPUT_NO_DEVICES=1
# Invisible cursor theme written by install.sh: no arrow in the middle of the touch screen.
Environment=XCURSOR_PATH=@PREFIX@/cursors
Environment=XCURSOR_THEME=default
Environment=XCURSOR_SIZE=24
EnvironmentFile=-/etc/floppyoctotouch/kiosk.env
# -s: allow switching to another VT (Ctrl+Alt+F2 with a keyboard) for troubleshooting.
ExecStart=/usr/bin/cage -s -- @PREFIX@/deploy/kiosk/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
